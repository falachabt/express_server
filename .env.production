# Production Environment Variables
# Copy this file to .env on your server and adjust values

NODE_ENV=production
PORT=8080

# CORS Configuration
# Add your production domains separated by commas
CORS_ORIGIN=http://89.168.48.67:8080,https://yourdomain.com,*.elearnprepa.com,elearnprepa.com,*.ezadrive.com,ezadrive.com,*.fydelio.com,fydelio.com

# Logging
LOG_LEVEL=info

# Common configuration
COMMON_RATE_LIMIT_MAX_REQUESTS=1000
COMMON_RATE_LIMIT_WINDOW_MS=900000
